{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis-memory-lab:run-manifest-v1",
  "title": "Axis Memory Lab preliminary run manifest v1",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "device_identity", "scenario", "privacy_classification", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "device_identity": {"type": "string", "minLength": 1, "description": "Synthetic pseudonymous identity only in fixtures"},
    "scenario": {"type": "string", "minLength": 1},
    "privacy_classification": {"enum": ["synthetic", "redacted", "sensitive"]},
    "status": {"enum": ["started", "complete", "incomplete", "failed"]},
    "software_version": {"type": "string", "minLength": 1},
    "firmware_version": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "camera_model": {"type": "string", "minLength": 1},
    "soc": {"type": "string", "minLength": 1},
    "sdk_generation": {"type": "string", "minLength": 1},
    "libc": {"type": "string", "minLength": 1},
    "test_case_id": {"type": "string", "minLength": 1},
    "consent_reference": {"type": "string", "minLength": 1, "description": "Approved incident or consent identifier; never personal data"},
    "redaction_status": {"enum": ["not_applicable", "none", "redacted"]},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collector_version": {"type": "string", "minLength": 1},
    "workload": {
      "type": "object",
      "properties": {
        "resolution": {"type": "string", "minLength": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "codec": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
